# =============================================================================
# ENVIRONMENT CONFIGURATION FOR DOCKER DEPLOYMENT
# SISTEM RKM - PT KERINCI MERANGIN HIDRO (PLTA MERANGIN 350 MW)
# =============================================================================

APP_NAME="Sistem RKM - PT Kerinci Merangin Hidro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (DOCKER MYSQL 8.0)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rkm_kmh
DB_USERNAME=rkm_user
DB_PASSWORD=rkm_secret_password
DB_ROOT_PASSWORD=root_secret_password
FORWARD_DB_PORT=3306

# Flag to seed master data on first launch (set to true on initial deploy)
RUN_SEEDER=false

# -----------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@meranginhidro.com"
MAIL_FROM_NAME="${APP_NAME}"
